#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift / Caps Lock";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Left";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46 47>;
            hold-trigger-on-release;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Home Row Mod Right";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 34 42 43 44>;
            hold-trigger-on-release;
        };

        th_lt: th_lt {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Thumb Layer Tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            bindings = <&mo>, <&kp>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp TAB    &kp Q                 &kp W                &kp E                 &kp R                  &kp T                           &kp UP                &kp Y                    &kp U                       &kp I                     &kp O                    &kp P                    &kp DEL
&shift_caps  &hrm_left LCTRL A   &hrm_left LALT S     &hrm_left LGUI D      &hrm_left LEFT_SHIFT F &kp G                &kp LEFT  &kp ENTER  &kp RIGHT  &kp H                    &hrm_right LEFT_SHIFT J    &hrm_right LGUI K       &hrm_right LALT L      &hrm_right LCTRL SEMI   &kp SQT
&kp LCTRL  &kp Z                 &kp X                &kp C                 &kp V                  &kp B      &kp SPACE              &kp DOWN              &kp N                    &kp M                       &kp COMMA                 &kp DOT                  &kp FSLH                &kp ESC
                          &kp LGUI  &th_lt 1 TAB  &th_lt 2 SPACE                                                     &th_lt 3 ENTER  &kp BSPC  &th_lt 4 RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp ESC    &kp TAB    &kp INS           &kp HOME           &kp END             &kp DEL                          &mmv MOVE_UP                     &trans                  &kp HOME                  &kp PG_DN               &kp PG_UP               &kp END                 &kp DEL
&kp LGUI   &kp LALT   &kp LCTRL         &kp LEFT_SHIFT     &caps_word          &kp RET               &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans                  &kp LEFT                  &kp DOWN                &kp UP                  &kp RIGHT               &kp RET
&kp RALT   &kp BSPC   &kp DEL           &kp PG_DN          &kp PG_UP           &trans     &trans                       &mmv MOVE_DOWN                   &trans                  &kp BSPC                  &kp DEL                 &trans                  &trans                  &kp ESC
                                     &kp LGUI  &trans    &mo 2                                                               &mo 3         &kp BSPC  &mo 4
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp TAB    &kp LBKT   &kp N7            &kp N8             &kp N9              &kp RBKT                         &mmv MOVE_UP                     &trans                  &trans                    &trans                  &trans                  &trans                  &kp BSPC
&kp LGUI   &kp LALT   &kp LCTRL         &kp LEFT_SHIFT     &kp EQUAL           &trans                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans                  &kp N4                    &kp N5                  &kp N6                  &kp SEMI                &kp RET
&kp RALT   &kp GRAVE  &kp N1            &kp N2             &kp N3              &kp BSLH   &trans                       &mmv MOVE_DOWN                   &trans                  &kp MINUS                 &kp N0                  &kp DOT                 &mo 1                   &kp ESC
                                     &kp LGUI  &mo 1     &trans                                                              &mo 3         &kp BSPC  &mo 4
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        code_layer {
            display-name = "CODE";
            bindings = <
&kp TAB    &kp GRAVE  &kp TILDE         &kp HASH           &kp AMPS            &kp PIPE                         &mmv MOVE_UP                     &kp CARET               &kp LPAR                  &kp RPAR                &kp LBKT                &kp RBKT                &kp DEL
&kp LGUI   &kp EXCL   &kp COLON         &kp EQUAL          &kp UNDER           &kp DLLR             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp AT                   &kp LBRC                  &kp RBRC                &kp EQUAL               &kp GT                  &kp RET
&kp RALT   &kp PRCNT  &kp QMARK         &kp ASTRK          &kp PLUS            &kp BSLH   &trans                       &mmv MOVE_DOWN                   &kp FSLH                &kp UNDER                 &kp LT                  &kp GT                  &kp DQT                 &kp ESC
                                     &kp LGUI  &mo 1     &mo 2                                                                &trans         &kp BSPC  &mo 4
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        util_layer {
            display-name = "UTIL";
            bindings = <
&bt BT_CLR_ALL   &bt BT_SEL 0       &bt BT_SEL 1      &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_CLR                         &mmv MOVE_UP                     &kp F1                  &kp F2                    &kp F3                  &kp F4                  &kp F5                  &kp F6
&rgb_ug RGB_OFF  &rgb_ug RGB_ON     &rgb_ug RGB_EFF   &rgb_ug RGB_EFR    &rgb_ug RGB_BRI  &rgb_ug RGB_BRD        &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp F7                  &kp F8                    &kp F9                  &kp F10                 &kp F11                 &kp F12
&out OUT_USB     &out OUT_BLE       &studio_unlock    &bootloader        &sys_reset       &kp C_MUTE   &kp C_PP                    &mmv MOVE_DOWN                   &kp PRINTSCREEN         &kp SCROLLLOCK            &soft_off               &kp INS                 &kp DEL                 &kp ESC
                                           &kp LGUI  &mo 1           &mo 2                                                             &mo 3          &kp BSPC  &kp RALT
            >;

            sensor-bindings = <&rgb_encoder>;
        };
    };
};
